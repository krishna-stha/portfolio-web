# Copy this file to .env.local (dev) or set these in your host's dashboard (production).

# Signs admin session tokens. Set this to a long random string in production —
# e.g. `openssl rand -hex 32`. If you don't set it, a fixed insecure dev
# default is used, which is fine for local testing but NOT safe to deploy with.
SESSION_SECRET=

# There is no ADMIN_PASSWORD variable — the admin password is stored
# (hashed) in data/admin-auth.json and is managed entirely from the
# Settings tab inside the admin panel itself.
